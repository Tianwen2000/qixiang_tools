APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
TEMP_DIR=./app/temp
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif,bmp,ico,tif,tiff
ALLOWED_PDF_TYPES=pdf
FILE_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 登录 / AI 模块（复制为 backend/.env 后按需修改，.env 已被 gitignore）=====
# MySQL 连接串：生产必填真实账号密码。先建库（表会在首次登录时自动创建）：
#   CREATE DATABASE IF NOT EXISTS qixiang_tools DEFAULT CHARACTER SET utf8mb4;
# 数据库连不上时仅登录功能降级，其它工具不受影响。
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/qixiang_tools?charset=utf8mb4
# 登录有效期 / Cookie 过期时间（天）——二者一致，默认 30 天。
SESSION_EXPIRE_DAYS=30
# 会话 Cookie 名称（一般不用改）。
SESSION_COOKIE_NAME=qx_session
# 生产 HTTPS 下建议设为 true（Cookie 仅经 https 发送）；本地 http 调试保持 false。
SESSION_COOKIE_SECURE=false

# ===== 独立后台管理系统（只在后端 .env 配置，不写进前端）=====
# 后台账号密码不复用 AI 登录用户；未配置时后台接口会返回 503。
BACKOFFICE_ACCOUNT=
BACKOFFICE_PASSWORD=
BACKOFFICE_ENTRY_QUESTION=如果时间忘记了名字，它会把前三个音节藏在哪里？
BACKOFFICE_ENTRY_ANSWER=
BACKOFFICE_COOKIE_NAME=qx_backoffice_session
BACKOFFICE_SESSION_HOURS=12
